// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum AccountAuditAction {
  ACCOUNT_CREATED
  CREDENTIALS_ISSUED
  CREDENTIALS_REISSUED
  PASSWORD_RESET
  PASSWORD_CHANGED
  FORCE_PASSWORD_CHANGE
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_DISABLED
  ACCOUNT_UNLOCKED
  ACCOUNT_DELETED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  PROVISIONING
  FAILED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  PROBATION
  RESIGNED
  TERMINATED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  EXPELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum NoticePriority {
  LOW
  MEDIUM
  HIGH
}

enum TeacherDesignation {
  PRINCIPAL
  VICE_PRINCIPAL
  COORDINATOR
  SENIOR_TEACHER
  TEACHER
  ASSISTANT_TEACHER
}

// ─── Finance Enums ────────────────────────────────────────────

enum FeeCategory {
  STANDARD
  SIBLING
}

enum FeeRecordStatus {
  PENDING
  PAID
  PARTIAL
  WAIVED
  OVERDUE
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlanTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum NotificationType {
  NOTICE
  ANNOUNCEMENT
  HOMEWORK
  FEE_REMINDER
  EXAM
  ADMIT_CARD
  RESULT
  HOLIDAY
  EMERGENCY
  CIRCULAR
}

// ─── Academic Document Engine Enums (Phase 5) ─────────────

enum DocumentType {
  ADMIT_CARD
  REPORT_CARD
  FEE_RECEIPT
  TRANSFER_CERTIFICATE
  BONAFIDE_CERTIFICATE
  CHARACTER_CERTIFICATE
  STUDENT_ID_CARD
  TEACHER_ID_CARD
  SALARY_SLIP
  EXPERIENCE_CERTIFICATE
  LEAVING_CERTIFICATE
  MIGRATION_CERTIFICATE
}

enum TemplatePreset {
  CBSE
  ICSE
  STATE_BOARD
  CUSTOM
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  PUBLISHED
  REVOKED
  ARCHIVED
  QUEUED
  PROCESSING
  FAILED
}

// ─── Platform & School Management (CloudEMS SaaS v2) ──────────

model School {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  slug           String       @unique
  customDomain   String?      @unique @map("custom_domain")
  logoUrl        String?      @map("logo_url")
  status         SchoolStatus @default(PROVISIONING)
  failureReason  String?      @map("failure_reason")
  provisionedAt  DateTime?    @map("provisioned_at")

  // School contact & location
  schoolType     String?      @map("school_type")   // e.g. PRIMARY, SECONDARY, K12
  contactEmail   String?      @map("contact_email")
  contactPhone   String?      @map("contact_phone")
  website        String?
  address        String?
  city           String?
  state          String?
  country        String       @default("India")
  pincode        String?

  // Legacy field — kept for backward compatibility, derived from status
  isActive       Boolean      @default(true) @map("is_active")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  settings            SchoolSettings?
  features            SchoolFeatures?
  subscriptions       Subscription[]
  users               User[]
  parents             Parent[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  academicSessions    AcademicSession[]
  classes             Class[]
  sections            Section[]
  subjects            Subject[]
  classSubjects       ClassSubject[]
  teachers            Teacher[]
  teacherAssignments  TeacherAssignment[]
  students            Student[]
  studentParents      StudentParent[]
  timetables          Timetable[]
  periodMasters       PeriodMaster[]
  attendances         Attendance[]
  attendanceRecords   AttendanceRecord[]
  notices             Notice[]
  usernameSequences   UsernameSequence[]
  accountAuditLogs    AccountAuditLog[]
  feePlans            FeePlan[]
  feeRecords          FeeRecord[]
  feePayments         FeePayment[]
  feeReminderRules    FeeReminderRule[]
  announcements       Announcement[]
  exams               Exam[]
  examSchedules       ExamSchedule[]
  admitCards          AdmitCard[]
  examMarks           ExamMark[]
  reportCards         ReportCard[]
  examTemplates       ExamTemplate[]
  homework            Homework[]
  homeworkSubmissions HomeworkSubmission[]
  academicDocumentTemplates AcademicDocumentTemplate[]
  generatedDocuments  GeneratedDocument[]
  upgradeRequests     UpgradeRequest[]

  @@index([slug])
  @@index([customDomain])
  @@map("schools")
}

model SchoolSettings {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @unique @map("school_id") @db.Uuid
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  logoUrl           String?  @map("logo_url")
  primaryColor      String   @default("#4F46E5") @map("primary_color")
  accentColor       String   @default("#06B6D4") @map("accent_color")
  principalName     String?  @map("principal_name")
  address           String?
  city              String?
  state             String?
  country           String   @default("India")
  pincode           String?
  phone             String?
  email             String?

  sessionStartMonth Int      @default(4) @map("session_start_month")
  workingDays       String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"]) @map("working_days")
  attendanceRules   Json?    @map("attendance_rules")
  gradingRules      Json?    @map("grading_rules")
  dateFormat        String   @default("DD/MM/YYYY") @map("date_format")
  timeZone          String   @default("Asia/Kolkata") @map("time_zone")
  currency          String   @default("INR")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("school_settings")
}

model SchoolFeatures {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @unique @map("school_id") @db.Uuid
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  attendanceModule Boolean  @default(true) @map("attendance_module")
  feesModule       Boolean  @default(true) @map("fees_module")
  examModule       Boolean  @default(true) @map("exam_module")
  homeworkModule   Boolean  @default(true) @map("homework_module")
  noticeModule     Boolean  @default(true) @map("notice_module")
  transportModule  Boolean  @default(false) @map("transport_module")
  libraryModule    Boolean  @default(false) @map("library_module")
  hostelModule     Boolean  @default(false) @map("hostel_module")
  inventoryModule  Boolean  @default(false) @map("inventory_module")
  payrollModule    Boolean  @default(false) @map("payroll_module")
  onlineExamModule Boolean  @default(false) @map("online_exam_module")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("school_features")
}

model Plan {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  tier         PlanTier       @default(BASIC)
  monthlyPrice Int            @map("monthly_price")
  yearlyPrice  Int            @map("yearly_price")
  maxStudents  Int            @default(500) @map("max_students")
  maxStorageMb Int            @default(5120) @map("max_storage_mb")
  features     Json
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @map("school_id") @db.Uuid
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId          String?            @map("plan_id") @db.Uuid
  plan            Plan?              @relation(fields: [planId], references: [id])
  
  currentPlan     String             @default("BASE") @map("current_plan")
  monthlyPrice    Int                @default(1000) @map("monthly_price")
  yearlyPrice     Int                @default(10000) @map("yearly_price")
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @default(now()) @map("start_date")
  endDate         DateTime?          @map("end_date")
  gracePeriodDays Int                @default(7) @map("grace_period_days")
  autoRenew       Boolean            @default(true) @map("auto_renew")

  invoices        SubscriptionInvoice[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("subscriptions")
}

model UpgradeRequest {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  currentPlan   String   @map("current_plan")
  requestedPlan String   @default("PREMIUM") @map("requested_plan")
  status        String   @default("PENDING") // PENDING, CONTACTED, COMPLETED, REJECTED
  requestedBy   String?  @map("requested_by")
  notes         String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([status])
  @@map("upgrade_requests")
}

model SubscriptionInvoice {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Int
  status         String
  paidAt         DateTime?    @map("paid_at")
  pdfUrl         String?      @map("pdf_url")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("subscription_invoices")
}

model Parent {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String   @unique @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName   String   @map("full_name")
  occupation String?
  address    String?
  city       String?
  state      String?
  pincode    String?

  students   StudentParent[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("parents")
}

model StudentParent {
  schoolId  String  @map("school_id") @db.Uuid
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String  @map("parent_id") @db.Uuid
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String  @default("FATHER")

  @@id([studentId, parentId])
  @@index([schoolId])
  @@map("student_parents")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String           @db.Text
  payload     Json?
  
  targetRole  Role?            @map("target_role")
  recipientId String?          @map("recipient_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  sentAt      DateTime         @default(now()) @map("sent_at")

  @@index([schoolId, recipientId])
  @@index([schoolId, targetRole])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @map("school_id") @db.Uuid
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  role       Role
  module     String?  // e.g. PLATFORM, SCHOOL, AUTH, FEES, EXAM
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  result     String   @default("SUCCESS")  // SUCCESS | FAILURE
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  device     String?

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId])
  @@index([userId])
  @@index([module])
  @@index([result])
  @@map("audit_logs")
}

// ─── User ─────────────────────────────────────────────────────

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  schoolId            String?       @map("school_id") @db.Uuid
  school              School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  username            String        @unique
  phone               String?
  email               String        @unique
  passwordHash        String        @map("password_hash")
  role                Role
  accountStatus       AccountStatus @default(ACTIVE) @map("account_status")
  mustChangePassword  Boolean       @default(true) @map("must_change_password")
  refreshTokenVersion Int           @default(0) @map("refresh_token_version")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime?     @map("last_failed_login_at")
  lockedUntil         DateTime?     @map("locked_until")
  lastLoginAt         DateTime?     @map("last_login_at")
  passwordChangedAt   DateTime?     @map("password_changed_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  teacher          Teacher?
  student          Student?
  parent           Parent?
  notices          Notice[]
  accountAuditLogs AccountAuditLog[] @relation("AuditSubject")
  actionsPerformed AccountAuditLog[] @relation("AuditActor")
  auditLogs        AuditLog[]

  @@index([schoolId])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

// ─── Academic Session ─────────────────────────────────────────

model AcademicSession {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students           Student[]
  timetables         Timetable[]
  feePlans           FeePlan[]
  feeRecords         FeeRecord[]
  teacherAssignments TeacherAssignment[]
  announcements      Announcement[]
  exams              Exam[]
  admitCards         AdmitCard[]
  periodMasters      PeriodMaster[]
  homework           Homework[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isActive])
  @@map("academic_sessions")
}

// ─── Class ────────────────────────────────────────────────────

model Class {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sections           Section[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  students           Student[]
  timetables         Timetable[]
  feePlans           FeePlan[]
  feeRecords         FeeRecord[]
  announcements      Announcement[]
  homework           Homework[]
  exams              Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isActive])
  @@index([displayOrder])
  @@map("classes")
}

// ─── Section ──────────────────────────────────────────────────

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int      @default(40)
  isActive  Boolean  @default(true) @map("is_active")
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class              Class               @relation(fields: [classId], references: [id])
  teacherAssignments TeacherAssignment[]
  students           Student[]
  timetables         Timetable[]
  attendance         Attendance[]
  announcements      Announcement[]
  homework           Homework[]
  exams              Exam[]

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([classId])
  @@index([isActive])
  @@map("sections")
}

// ─── Subject ──────────────────────────────────────────────────

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetables         Timetable[]
  homework           Homework[]
  examSchedules      ExamSchedule[]
  examMarks          ExamMark[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([isActive])
  @@map("subjects")
}

// ─── Class–Subject Assignment ─────────────────────────────────

model ClassSubject {
  schoolId  String @map("school_id") @db.Uuid
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@id([classId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

// ─── Teacher ──────────────────────────────────────────────────

model Teacher {
  id               String              @id @default(uuid()) @db.Uuid
  schoolId         String              @map("school_id") @db.Uuid
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId           String?             @unique @map("user_id") @db.Uuid
  employeeId       String              @map("employee_id")
  firstName        String              @map("first_name")
  lastName         String              @map("last_name")
  gender           Gender
  dateOfBirth      DateTime?           @map("date_of_birth") @db.Date
  phone            String?
  email            String
  qualification    String?
  experienceYears  Int                 @default(0) @map("experience_years")
  department       String?
  designation      TeacherDesignation? @default(TEACHER) @map("designation")
  joiningDate      DateTime            @map("joining_date") @db.Date
  employmentStatus EmploymentStatus    @default(PERMANENT) @map("employment_status")
  address          String?
  bloodGroup       BloodGroup?         @map("blood_group")
  emergencyContact String?             @map("emergency_contact")
  emergencyPhone   String?             @map("emergency_phone")
  photoUrl         String?             @map("photo_url")
  notes            String?
  isActive         Boolean             @default(true) @map("is_active")
  deletedAt        DateTime?           @map("deleted_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user               User?               @relation(fields: [userId], references: [id])
  assignments        TeacherAssignment[]
  timetables         Timetable[]
  announcements      Announcement[]
  homework           Homework[]
  generatedDocuments GeneratedDocument[]

  @@unique([schoolId, employeeId])
  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([isActive])
  @@index([employmentStatus])
  @@index([designation])
  @@index([deletedAt])
  @@map("teachers")
}

// ─── Teacher Assignment ───────────────────────────────────────

model TeacherAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId      String  @map("teacher_id") @db.Uuid
  sessionId      String  @map("session_id") @db.Uuid
  classId        String  @map("class_id") @db.Uuid
  sectionId      String  @map("section_id") @db.Uuid
  subjectId      String  @map("subject_id") @db.Uuid
  isClassTeacher Boolean @default(false) @map("is_class_teacher")

  teacher Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [sessionId], references: [id])
  class   Class           @relation(fields: [classId], references: [id])
  section Section         @relation(fields: [sectionId], references: [id])
  subject Subject         @relation(fields: [subjectId], references: [id])

  @@unique([schoolId, teacherId, sessionId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([sessionId])
  @@index([classId])
  @@index([isClassTeacher])
  @@index([teacherId, sectionId])
  @@map("teacher_assignments")
}

// ─── Student ──────────────────────────────────────────────────

model Student {
  id              String      @id @default(uuid()) @db.Uuid
  schoolId        String      @map("school_id") @db.Uuid
  school          School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String?     @unique @map("user_id") @db.Uuid
  admissionNumber String      @map("admission_number")
  rollNumber      String?     @map("roll_number")
  firstName       String      @map("first_name")
  lastName        String      @map("last_name")
  gender          Gender
  dateOfBirth     DateTime?   @map("date_of_birth") @db.Date
  bloodGroup      BloodGroup? @map("blood_group")
  phone           String?
  email           String?
  photoUrl        String?     @map("photo_url")

  // Parent Information
  fatherName  String? @map("father_name")
  fatherPhone String? @map("father_phone")
  motherName  String? @map("mother_name")
  motherPhone String? @map("mother_phone")

  // Guardian Information
  guardianName     String? @map("guardian_name")
  guardianPhone    String? @map("guardian_phone")
  guardianRelation String? @map("guardian_relation")

  // Emergency Contact
  emergencyContact String? @map("emergency_contact")
  emergencyPhone   String? @map("emergency_phone")

  address String?

  // Academic Assignment
  sessionId String? @map("session_id") @db.Uuid
  classId   String? @map("class_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid

  // Fee Assignment
  feeCategory      FeeCategory? @default(STANDARD) @map("fee_category")
  feePlanId        String?      @map("fee_plan_id") @db.Uuid
  siblingStudentId String?      @map("sibling_student_id") @db.Uuid
  siblingFeeAmount Int?         @map("sibling_fee_amount")

  admissionDate  DateTime      @map("admission_date") @db.Date
  status         StudentStatus @default(ACTIVE)
  notes          String?
  advanceBalance Int           @default(0) @map("advance_balance") // paise

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user    User?            @relation(fields: [userId], references: [id])
  session AcademicSession? @relation(fields: [sessionId], references: [id])
  class   Class?           @relation(fields: [classId], references: [id])
  section Section?         @relation(fields: [sectionId], references: [id])

  feePlan   FeePlan?  @relation(fields: [feePlanId], references: [id])
  sibling   Student?  @relation("SiblingRelation", fields: [siblingStudentId], references: [id])
  siblingOf Student[] @relation("SiblingRelation")

  attendanceRecords   AttendanceRecord[]
  feeRecords          FeeRecord[]
  admitCards          AdmitCard[]
  reportCards         ReportCard[]
  examMarks           ExamMark[]
  homeworkSubmissions HomeworkSubmission[]
  parents             StudentParent[]
  generatedDocuments  GeneratedDocument[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([isActive])
  @@index([status])
  @@index([deletedAt])
  @@index([sessionId])
  @@index([classId])
  @@index([sectionId])
  @@index([feePlanId])
  @@index([classId, sectionId, isActive])
  @@index([userId])
  @@map("students")
}

